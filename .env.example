# Required only for contact/career email delivery. Never commit real credentials.
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/bg_elevators_cms
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ENQUIRY_TO=info@bgelevators.com
CAREERS_TO=info@bgelevators.com
# Set to 1 only when behind one trusted reverse proxy.
TRUST_PROXY=0
# Optional: browser endpoint if the form service is separately hosted.
# VITE_FORM_ENDPOINT=https://your-domain.example/api/enquiry
VITE_GOOGLE_SITE_VERIFICATION=
VITE_GA_MEASUREMENT_ID=
SITE_URL=https://www.bgelevators.com
